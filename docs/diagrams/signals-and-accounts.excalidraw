   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Same bot name under two accounts never collides:\njobs, gate flags, and audit rows are all keyed (account, bot).\nState is keyed by bot name only \u2014 use per-account state\nstores (or key prefixes) if the same registry drives both.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Same bot name under two accounts never collides:\njobs, gate flags, and audit rows are all keyed (account, bot).\nState is keyed by bot name only \u2014 use per-account state\nstores (or key prefixes) if the same registry drives both.",
   "autoResize": true,
   "lineHeight": 1.25
  }
